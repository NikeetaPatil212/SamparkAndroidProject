<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F6"
    android:fitsSystemWindows="true">

    <!-- ============================================================
         TOOLBAR
         ============================================================ -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2E7D32"
        android:elevation="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/outline_arrow_back_24"
            android:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Fee Reminder"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ============================================================
         MAIN SCROLL
         ============================================================ -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">


            <!-- ====================================================
                 FEE REMINDER HEADER
                 ==================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fee Reminder"
                android:textColor="#424242"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />


            <!-- ====================================================
                 DATE + SEND MESSAGE CARD
                 ==================================================== -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">


                    <!-- DATE ROW -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <!-- FROM DATE -->

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFromDate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:hint="Reminder From Date"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="#2E7D32">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFromDate"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:focusable="false"
                                android:clickable="true"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="#424242"
                                android:drawableEnd="@drawable/baseline_calendar_today_24"
                                android:drawableTint="#2E7D32" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- TO DATE -->

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilToDate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:hint="Reminder To Date"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxStrokeColor="#2E7D32">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etToDate"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:focusable="false"
                                android:clickable="true"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="#424242"
                                android:drawableEnd="@drawable/baseline_calendar_today_24"
                                android:drawableTint="#2E7D32" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>


                    <!-- BUTTON ROW -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">


                        <!-- SEND MESSAGE TO ALL -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendMessageAll"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.5"
                            android:layout_marginEnd="8dp"
                            android:text="Send Message To All"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#E6C229"
                            app:cornerRadius="7dp"
                            app:icon="@drawable/whatsapp"
                            app:iconTint="#FFFFFF"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp" />


                        <!-- SHOW BUTTON -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShow"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="0.8"
                            android:text="Show"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#28618C"
                            app:cornerRadius="7dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ====================================================
                 RESULT SUMMARY
                 ==================================================== -->

            <LinearLayout
                android:id="@+id/llResultHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fee Reminders"
                    android:textColor="#424242"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_green"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="0 Students"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ====================================================
                 TABLE CARD
                 ==================================================== -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardReminderTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <!-- TABLE TITLE -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#2E7D32"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_article_24"
                            android:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Students"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Selected"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- =================================================
                         HORIZONTAL TABLE SCROLL
                         ================================================= -->

                    <HorizontalScrollView
                        android:id="@+id/horizontalTableScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="false"
                        android:scrollbars="horizontal"
                        android:fadeScrollbars="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <!-- =========================================
                                 TABLE HEADER
                                 ========================================= -->

                            <LinearLayout
                                android:id="@+id/tableHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="#E8F5E9">


                                <!-- SR NO -->

                                <TextView
                                    android:layout_width="45dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Sr\nNo"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- ADMISSION ID -->

                                <TextView
                                    android:layout_width="80dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Admission\nID"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- STUDENT NAME -->

                                <TextView
                                    android:layout_width="150dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Student Name"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- MOBILE -->

                                <TextView
                                    android:layout_width="115dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Mobile"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- COURSE -->

                                <TextView
                                    android:layout_width="105dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Course"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- BATCH -->

                                <TextView
                                    android:layout_width="95dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Batch"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- OUTSTANDING -->

                                <TextView
                                    android:layout_width="110dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Outstanding"
                                    android:textColor="#C62828"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <!-- LOCATION -->

                                <TextView
                                    android:layout_width="110dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Location"
                                    android:textColor="#2E7D32"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <!-- HEADER DIVIDER -->

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D0D0D0" />


                            <!-- =================================================
                                 RECYCLER VIEW
                                 ================================================= -->

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvFeeReminder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        </LinearLayout>

                    </HorizontalScrollView>


                    <!-- =================================================
                         EMPTY STATE
                         ================================================= -->

                    <LinearLayout
                        android:id="@+id/llEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="35dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/baseline_article_24"
                            android:tint="#BDBDBD" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="No fee reminders found"
                            android:textColor="#888888"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ====================================================
                 BOTTOM SPACE
                 ==================================================== -->

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ============================================================
         LOADER
         ============================================================ -->

    <FrameLayout
        android:id="@+id/loaderLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>